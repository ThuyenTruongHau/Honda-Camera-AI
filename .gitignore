# ======================
# Environment variables
# ======================
.env
.env.*
# Vẫn commit file cấu hình mẫu, không chứa credential thật
!.env.example

# Nếu .env nằm trong thư mục con
**/.env

# ======================
# Python cache
# ======================
__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

# Local verification output
.pytest_cache/
artifacts/
**/logs/
**/.venv/
logic_service/runtime/
camera_cluster/runtime/
camera_cluster/config/cameras.json
ai_service/runtime/
# Real camera config may contain RTSP credentials; commit the example only.
logic_service/config/cameras.json
