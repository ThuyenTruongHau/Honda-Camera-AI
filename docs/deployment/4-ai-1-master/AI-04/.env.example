# Example LAN plan; replace MASTER IP on every AI host.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
CLUSTER_ENABLED=true
WORKER_ID=AI-04
CLUSTER_URL=http://192.168.1.10:8002
AI_DATA_URL=http://192.168.1.10:8001/ai-data
WEIGHT_PATH=weights/ModelHN_170926.engine
TARGET_FPS=5
NUM_PROCESS=4
CLUSTER_HEARTBEAT_INTERVAL=3
CLUSTER_HTTP_TIMEOUT=2
CLUSTER_LEASE_MARGIN=1
CLUSTER_MAX_FRAME_AGE=3
CLUSTER_REPORT_INTERVAL=1
CLUSTER_REPORT_BATCH_SIZE=32
CLUSTER_INFERENCE_BATCH_SIZE=16
CLUSTER_INFERENCE_TIMEOUT=10
CLUSTER_MODEL_START_TIMEOUT=120
CLUSTER_CAPTURE_OPEN_TIMEOUT_MS=4000
CLUSTER_CAPTURE_READ_TIMEOUT_MS=4000
CLUSTER_CAMERA_STOP_TIMEOUT=6
CLUSTER_START_CONCURRENCY=8
CLUSTER_SOURCE_RETRY_DELAY=2
CLUSTER_PROCESS_RESTART_DELAY=3
LOG_LEVEL=INFO
LOG_DIR=logs
CAMERA_SUMMARY_INTERVAL=15
DETECTION_LOG_INTERVAL=10
DEBUG_SAVE_SNAPSHOTS=false
DEBUG_SNAPSHOT_INTERVAL=30
DEBUG_SNAPSHOT_DIR=logs/snapshots
