# Use AI-01 / AI-02 / AI-03 / AI-04 and the matching master token on each host.
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
CLUSTER_ENABLED=true
WORKER_ID=AI-01
WORKER_TOKEN=replace-worker-1-token
CLUSTER_URL=http://127.0.0.1:8002
# Point-data destination is the business service, not the coordinator.
AI_DATA_URL=http://127.0.0.1:8001/ai-data
# Set empty only when testing camera control without delivering detections.
# Replace CLUSTER_URL with the coordinator LAN address on remote AI machines.
WEIGHT_PATH=weights/run3.pt
TARGET_FPS=5
NUM_PROCESS=4
CLUSTER_HEARTBEAT_INTERVAL=3
CLUSTER_HTTP_TIMEOUT=2
CLUSTER_LEASE_MARGIN=1
CLUSTER_MAX_FRAME_AGE=3
CLUSTER_REPORT_INTERVAL=1
CLUSTER_INFERENCE_BATCH_SIZE=16
CLUSTER_CAPTURE_OPEN_TIMEOUT_MS=4000
CLUSTER_CAPTURE_READ_TIMEOUT_MS=4000
CLUSTER_CAMERA_STOP_TIMEOUT=6
CLUSTER_INFERENCE_TIMEOUT=10
CLUSTER_START_CONCURRENCY=8

# Diagnostics: logs/ai_<pid>.log, daily rotation, 30 retained files per process.
LOG_LEVEL=INFO
LOG_DIR=logs
CAMERA_SUMMARY_INTERVAL=15
DETECTION_LOG_INTERVAL=10
# Enable while comparing detections against real camera images.
DEBUG_SAVE_SNAPSHOTS=false
DEBUG_SNAPSHOT_INTERVAL=30
DEBUG_SNAPSHOT_DIR=logs/snapshots
