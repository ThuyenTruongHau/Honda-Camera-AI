# Copy to .env and replace tokens. Start exactly ONE master application process.
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=false
CLUSTER_ENABLED=true
# Keep false during camera acceptance tests. Enable explicitly for robot operation.
CLUSTER_ROBOT_ENABLED=false
CLUSTER_CAMERA_CONFIG_PATH=config/cameras.json
# Keep this small overwritten boot counter across upgrades/restarts. No detect history.
CLUSTER_BOOT_STATE_PATH=runtime/cluster_boot.json
CLUSTER_MAX_CAMERAS=1000
CLUSTER_MAX_ROIS_PER_CAMERA=256
CLUSTER_HISTORY_LIMIT=1000
CLUSTER_SSE_QUEUE_SIZE=128
CLUSTER_SSE_MAX_CLIENTS=32
CLUSTER_WORKER_TOKENS={"AI-01":"replace-worker-1-token","AI-02":"replace-worker-2-token","AI-03":"replace-worker-3-token","AI-04":"replace-worker-4-token"}
CLUSTER_HEARTBEAT_INTERVAL=3
CLUSTER_LEASE_SECONDS=15
CLUSTER_TICK_SECONDS=1
CLUSTER_RECOVERY_DELAY=10
CLUSTER_REBALANCE_BATCH=10
CLUSTER_MAX_FRAME_AGE=3
CLUSTER_CLOCK_SKEW=1
TIME_RECOGNITION=5
# Set ICS_HOST to the actual robot controller only when enabling robot operation.
ICS_HOST=127.0.0.1
